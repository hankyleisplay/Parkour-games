{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CyberRunner3D",
  "version": "0.1.0",
  "identifier": "com.hankyleisplay.cyberrunner3d",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Cyber Runner 3D - 霓虹極速跑酷",
        "width": 1280,
        "height": 768,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
