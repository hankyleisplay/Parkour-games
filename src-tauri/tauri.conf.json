{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MarioParkour",
  "version": "0.2.0",
  "identifier": "com.hankyleisplay.marioparkour",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Retro Arcade All-in-One - 全能經典小遊戲平台 (馬力歐跑酷 / 2048 / 俄羅斯方塊 / 貪吃蛇)",
        "width": 1280,
        "height": 760,
        "minWidth": 860,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
